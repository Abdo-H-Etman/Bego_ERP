{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "tenancy": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/tenancy/{**catch-all}"
        }
      },
      "accounting": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/accounting/{**catch-all}"
        }
      },
      "inventory": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "sales": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/sales/{**catch-all}"
        }
      },
      "purchasing": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/purchasing/{**catch-all}"
        }
      },
      "identity": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "metadata": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/metadata/{**catch-all}"
        }
      },
      "workflow": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/workflow/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "integrations": {
        "ClusterId": "erp",
        "Match": {
          "Path": "/api/integrations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "erp": {
        "Destinations": {
          "monolith": {
            "Address": "http://localhost:5050/"
          }
        }
      }
    }
  }
}
